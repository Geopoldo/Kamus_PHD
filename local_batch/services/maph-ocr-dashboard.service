[Unit]
Description=MAP-H local OCR dashboard
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=MAPH_DASHBOARD_BIND=0.0.0.0
Environment=MAPH_DASHBOARD_NETWORK=192.168.1.0/24
Environment=MAPH_DASHBOARD_HOSTS=192.168.1.16:8091
WorkingDirectory=/home/ewok/Documents/ChatGPT/MAP-H-NOV14-CADDOCS
ExecStart=/usr/bin/python3 /home/ewok/Documents/ChatGPT/MAP-H-NOV14-CADDOCS/local_batch/dashboard.py
Restart=on-failure
RestartSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
